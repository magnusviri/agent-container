#!/usr/bin/env bash
set -eo pipefail

# -----------------------------------------------------------------------------
# Configuration
# -----------------------------------------------------------------------------

AGENT_HOME="${AI_AGENT_HOME:-$HOME/.agent-container}"
IMAGE="${AI_AGENT_IMAGE:-agent-container:latest}"

SSH_HOST_PORT="${AI_AGENT_SSH_PORT:-}"
CODEX_HOST_PORT="${AI_AGENT_CODEX_PORT:-1455}"

WORKSPACE="$(pwd -P)"

WORKSPACE_ID="$(
    printf '%s' "$WORKSPACE" \
        | if command -v sha256sum >/dev/null 2>&1; then
            sha256sum
          elif command -v shasum >/dev/null 2>&1; then
            shasum -a 256
          else
            echo "Neither sha256sum nor shasum is available." >&2
            exit 1
          fi \
        | cut -c1-12
)"

CONTAINER_NAME="agent-${WORKSPACE_ID}"

SESSIONS_DIR="$AGENT_HOME/sessions"

EXTRA_PORTS=()
DOCKER_ARGS=()
COMMAND=()
PORT_ARGS=()
RUN_ARGS=()
IO_ARGS=(--interactive)
CREDENTIAL_MOUNT_ARGS=()

if [[ -t 0 && -t 1 ]]; then
    IO_ARGS+=(--tty)
fi

PUBLISH_SSH=0
PUBLISH_CODEX=0
CODEX_AUTH_ENABLED=1
VERBOSE="${AI_AGENT_VERBOSE:-0}"
CREDENTIALS_DIR=""
CREDENTIALS_READ_ONLY=0
CREDENTIALS_REQUESTED=0

# -----------------------------------------------------------------------------
# Verbose logging
# -----------------------------------------------------------------------------

# Echo a command to stderr, quoted so it can be copied and rerun as-is.
log_command() {
    [[ "$VERBOSE" == 1 ]] || return 0

    {
        printf '+'
        printf ' %q' "$@"
        printf '\n'
    } >&2
}

# Log an explanatory note about what the launcher is doing or skipping.
log_verbose() {
    [[ "$VERBOSE" == 1 ]] || return 0

    printf '# %s\n' "$*" >&2
}

run_docker() {
    log_command docker "$@"
    docker "$@"
}

exec_docker() {
    log_command docker "$@"
    exec docker "$@"
}

# -----------------------------------------------------------------------------
# Help
# -----------------------------------------------------------------------------

usage() {
    cat <<'EOF'
Usage:
  agent [options] [--] [command...]
  agent init
  agent build [docker-build-options...]
  agent exec [command...]
  agent stop
  agent delete
  agent status
  agent list

Behavior:
  agent
      If a container is already running for the current directory, attach to it
      with an interactive Bash shell.

      If no container is running but a stopped container exists, offer to start
      it. When the last interactive terminal exits, the container is stopped.

      If no container exists, start a new container with Bash.

      If the configured image does not exist, offer to build it before starting
      the container.

  agent build [OPTIONS...]
      Build the configured agent image. Options are passed to docker build.

  agent init
      Install shortcuts for the launcher itself.

      Creates 'agent' and 'agent-container' symlinks to this script in:

        ~/.agent-container/bin

      and appends that directory to PATH in ~/.zshrc when it is not already
      present. Run it again to refresh the shortcuts and PATH entry.

  agent codex
      Start Codex in a new agent container.

      Codex defaults to --sandbox danger-full-access because the container
      provides the outer isolation boundary. Pass --sandbox or -s to override.

      When no persisted Codex login exists, Codex mode automatically publishes:
        container 22   -> an available host SSH port
        container 1455 -> host port 1455

      If ~/.agent-container/.codex/auth.json exists, authentication support is
      disabled automatically because Codex can use the persisted login.

      The launcher finds an available SSH host port starting at 2222.

  agent codex-ssh
      Open an SSH tunnel to the agent container publishing host port 1455.

      The SSH host port is discovered from that container's port mapping.
      Exits with an error if no running agent container publishes port 1455.

  agent claude
      Start Claude Code.

      Claude Code defaults to --dangerously-skip-permissions because the
      container provides the outer isolation boundary. Pass --permission-mode,
      --dangerously-skip-permissions, or --allow-dangerously-skip-permissions
      after claude to override.

      Every container sets IS_SANDBOX=1, which is what lets Claude Code accept
      that flag. The container runs as the unprivileged 'agent' user rather
      than root.

  agent opencode
      Start OpenCode.

      OpenCode defaults to --dangerously-skip-permissions because the
      container provides the outer isolation boundary. Pass --auto, --yolo,
      or --dangerously-skip-permissions after opencode to override.

  agent exec COMMAND...
      Execute COMMAND inside the running agent container for the current
      workspace.

      Examples:
        agent exec bash
        agent exec git status
        agent exec npm test
        agent exec bundle exec rspec

  agent stop
      Stop the running agent container for the current workspace.

  agent delete
      Delete the agent container for the current workspace, if it exists.

      Works whether the container is running or stopped.

  agent status
      Show whether an agent container is running for the current workspace.

  agent list
      List running agent containers with their IDs, names, images, statuses,
      ports, and host workspace paths.

Options:
  -p, --port PORT
      Publish an additional port.

      Examples:
        -p 3000
        -p 3000:3000
        -p 8080:3000
        -p 127.0.0.1:3000:3000

      A single port such as:

        -p 3000

      is interpreted as:

        -p 3000:3000

      Docker fixes published ports when a container is created, so this option
      only applies to a new container. When a container already exists for the
      workspace, delete it first:

        agent delete
        agent -p 3000 [command...]

  --ssh-port PORT
      Host port to map to container SSH port 22.

      This is only published automatically when running:

        agent codex

      If omitted, the launcher chooses the first available port starting at
      2222.

  --codex-port PORT
      Host port mapped to container port 1455.

      Default:
        1455

      This port is only published automatically when running:

        agent codex

  --no-codex-auth
      Disable Codex authentication support. Neither the SSH tunnel port nor
      callback port 1455 is published, and sshd is not started.

  --credentials DIR
      Share credentials from a home-style profile directory, read-write.

      Supported directories are mounted when present:
        DIR/.ssh       -> /home/agent/.ssh
        DIR/.config/gh -> /home/agent/.config/gh

  --credentials-ro DIR
      Share the same supported credential directories read-only.

      Credential sharing only applies when creating a new container. It is
      never enabled by default.

  --docker-arg ARG
      Pass an additional argument directly to docker run.

      Can be specified multiple times.

      Example:
        agent \
          --docker-arg --privileged \
          codex

  -v, --verbose
      Print every docker command the launcher runs, quoted so it can be copied
      and rerun as-is, plus notes about launcher decisions.

      Output goes to stderr.

  -h, --help
      Show this help.

Environment:
  AI_AGENT_HOME
      Agent configuration and persistent-state directory.

      Default:
        ~/.agent-container

  AI_AGENT_IMAGE
      Docker image to run.

      Default:
        agent-container:latest

  AI_AGENT_SSH_PORT
      Preferred host SSH port for Codex mode.

      If unset, the launcher automatically finds an available port.

  AI_AGENT_CODEX_PORT
      Host port for the Codex callback.

      Default:
        1455

  AI_AGENT_VERBOSE
      Set to 1 to enable verbose command logging without passing --verbose.

Persistent state:
  The following directories are mounted into every agent container:

    ~/.agent-container/.codex
        -> /home/agent/.codex

    ~/.agent-container/.claude
        -> /home/agent/.claude

    ~/.agent-container/.config/opencode
        -> /home/agent/.config/opencode

    ~/.agent-container/.local/share/opencode
        -> /home/agent/.local/share/opencode

Workspace:
  The current physical directory is mounted at:

    /workspace

Examples:
  agent init

  agent

  agent codex

  agent claude

  agent opencode

  agent -p 3000 codex

  agent -p 3000 -p 5173 claude

  agent --verbose -p 3000 claude

  agent --ssh-port 2222 codex

  agent --credentials "$HOME/.agent-credentials/work" codex

  agent --credentials-ro "$HOME/.agent-credentials/personal" claude

  agent exec bash

  agent exec git status

  agent exec npm test

  agent status

  agent stop

  agent delete
EOF
}

# -----------------------------------------------------------------------------
# Helpers
# -----------------------------------------------------------------------------

port_is_available() {
    local port="$1"

    # macOS/Linux when lsof is available.
    if command -v lsof >/dev/null 2>&1; then
        if lsof -nP \
            -iTCP:"$port" \
            -sTCP:LISTEN \
            >/dev/null 2>&1; then
            return 1
        fi

        return 0
    fi

    # Linux fallback.
    if command -v ss >/dev/null 2>&1; then
        if ss -ltn 2>/dev/null \
            | awk '{print $4}' \
            | grep -Eq "(^|:)$port$"; then
            return 1
        fi

        return 0
    fi

    # Last-resort TCP connection test.
    if command -v nc >/dev/null 2>&1; then
        if nc -z 127.0.0.1 "$port" >/dev/null 2>&1; then
            return 1
        fi

        return 0
    fi

    # If we cannot test it, assume unavailable rather than risk a collision.
    return 1
}

resolve_realpath() {
    local path="$1"
    local directory file target

    # Linux/coreutils readlink; falls back to manual symlink resolution below.
    if command -v readlink >/dev/null 2>&1 && readlink -f "$path" >/dev/null 2>&1; then
        printf '%s\n' "$(readlink -f "$path")"
        return
    fi

    directory="$(cd "$(dirname "$path")" && pwd -P)"
    file="$(basename "$path")"

    while [[ -L "$directory/$file" ]]; do
        target="$(readlink "$directory/$file")"
        if [[ "$target" == /* ]]; then
            directory="$(cd "$(dirname "$target")" && pwd -P)"
        else
            directory="$(cd "$directory/$(dirname "$target")" && pwd -P)"
        fi
        file="$(basename "$target")"
    done

    printf '%s\n' "$directory/$file"
}

find_available_ssh_port() {
    # Explicit override always wins.
    if [[ -n "$SSH_HOST_PORT" ]]; then
        printf '%s\n' "$SSH_HOST_PORT"
        return
    fi

    local port=2222

    while (( port <= 2299 )); do
        if port_is_available "$port"; then
            printf '%s\n' "$port"
            return
        fi

        ((port++))
    done

    echo "Unable to find an available SSH host port between 2222 and 2299." >&2
    exit 1
}

find_running_container() {
    run_docker ps \
        --filter "label=agent-container=true" \
        --filter "label=agent-workspace=${WORKSPACE_ID}" \
        --format '{{.ID}}' \
        | head -n 1
}

find_existing_container() {
    run_docker ps -a \
        --filter "label=agent-container=true" \
        --filter "label=agent-workspace=${WORKSPACE_ID}" \
        --format '{{.ID}}' \
        | head -n 1
}

interactive_tty() {
    local arg

    for arg in "${IO_ARGS[@]}"; do
        [[ "$arg" == "--tty" ]] && return 0
    done

    return 1
}

prune_sessions() {
    local entry pid

    for entry in "$SESSIONS_DIR"/"$CONTAINER_NAME".*; do
        [[ -e "$entry" ]] || continue
        pid="${entry##*.}"

        if [[ "$pid" =~ ^[0-9]+$ ]] \
            && [[ "$pid" != "$$" ]] \
            && ! kill -0 "$pid" 2>/dev/null; then
            rm -f "$entry"
        fi
    done
}

begin_session() {
    mkdir -p "$SESSIONS_DIR"
    prune_sessions
    : > "$SESSIONS_DIR/$CONTAINER_NAME.$$"
}

# shellcheck disable=SC2317 # invoked through the EXIT trap in run_interactive
end_session() {
    local entry running

    rm -f "$SESSIONS_DIR/$CONTAINER_NAME.$$"
    prune_sessions

    for entry in "$SESSIONS_DIR"/"$CONTAINER_NAME".*; do
        [[ -e "$entry" ]] && return 0
    done

    running="$(find_running_container)"
    [[ -n "$running" ]] || return 0

    echo "Stopping agent container $running"
    run_docker stop "$running" >/dev/null 2>&1 || true
}

run_interactive() {
    local rc=0

    begin_session
    trap end_session EXIT
    "$@" || rc=$?
    exit "$rc"
}

build_image() {
    local env_file="$AGENT_HOME/versions.env"
    local line key value
    local -a build_args=()
    local -a docker_build_args=("$@")

    if [[ -f "$env_file" ]]; then
        while IFS= read -r line || [[ -n "$line" ]]; do
            line="${line%$'\r'}"
            [[ -n "$line" && "$line" != \#* ]] || continue

            if [[ "$line" != *=* ]]; then
                echo "Invalid entry in $env_file: $line" >&2
                return 1
            fi

            key="${line%%=*}"
            value="${line#*=}"
            build_args+=(--build-arg "$key=$value")
        done < "$env_file"
    fi

    run_docker build \
        "${build_args[@]}" \
        "${docker_build_args[@]}" \
        --tag "$IMAGE" \
        "$AGENT_HOME"
}

ensure_image_exists() {
    local response

    if run_docker image inspect "$IMAGE" >/dev/null 2>&1; then
        return
    fi

    echo "Docker image '$IMAGE' is not built." >&2

    if [[ ! -t 0 ]]; then
        echo "Run 'agent build' to build it, then try again." >&2
        exit 1
    fi

    if ! read -r -p "Build it now? [Y/n] " response; then
        echo >&2
        echo "Build cancelled. Run 'agent build' when you are ready." >&2
        exit 1
    fi
    case "$response" in
        ""|y|Y|yes|YES|Yes)
            build_image
            ;;
        *)
            echo "Build cancelled. Run 'agent build' when you are ready."
            exit 1
            ;;
    esac
}

require_running_container() {
    local container
    container="$(find_running_container)"

    if [[ -z "$container" ]]; then
        echo "No running agent container found for:" >&2
        echo "  $WORKSPACE" >&2
        exit 1
    fi

    printf '%s\n' "$container"
}

# Docker fixes published ports when a container is created, so -p can only take
# effect on a 'docker run'. Reusing or attaching to an existing container has to
# say so rather than silently dropping the request.
requested_ports_summary() {
    local port

    for port in "${EXTRA_PORTS[@]}"; do
        echo "  -p $port"
    done
}

ports_require_new_container() {
    echo "Published ports can only be configured when creating a container." >&2
    echo "The existing container for this workspace does not publish:" >&2
    requested_ports_summary >&2
    echo >&2
    echo "Delete it, then relaunch with the port option:" >&2
    echo "  agent delete" >&2
    echo "  agent -p PORT [command...]" >&2
    exit 1
}

credentials_require_new_container() {
    echo "Credential mounts can only be configured when creating a container." >&2
    echo "Stop the running workspace container, then relaunch with the credential option:" >&2
    echo "  agent stop" >&2
    echo "  agent --credentials DIR [command...]" >&2
    echo "  agent --credentials-ro DIR [command...]" >&2
    exit 1
}

# -----------------------------------------------------------------------------
# Parse arguments
# -----------------------------------------------------------------------------

while [[ $# -gt 0 ]]; do
    case "$1" in
        -p|--port)
            [[ $# -ge 2 ]] || {
                echo "Missing value for $1" >&2
                exit 1
            }

            EXTRA_PORTS+=("$2")
            shift 2
            ;;

        --ssh-port)
            [[ $# -ge 2 ]] || {
                echo "Missing value for --ssh-port" >&2
                exit 1
            }

            SSH_HOST_PORT="$2"
            shift 2
            ;;

        --codex-port)
            [[ $# -ge 2 ]] || {
                echo "Missing value for --codex-port" >&2
                exit 1
            }

            CODEX_HOST_PORT="$2"
            shift 2
            ;;

        --no-codex-auth)
            CODEX_AUTH_ENABLED=0
            shift
            ;;

        -v|--verbose)
            VERBOSE=1
            shift
            ;;

        --credentials|--credentials-ro)
            [[ $# -ge 2 ]] || {
                echo "Missing value for $1" >&2
                exit 1
            }

            if [[ "$CREDENTIALS_REQUESTED" == 1 ]]; then
                echo "Specify only one of --credentials or --credentials-ro." >&2
                exit 1
            fi

            CREDENTIALS_DIR="$2"
            CREDENTIALS_REQUESTED=1

            if [[ "$1" == "--credentials-ro" ]]; then
                CREDENTIALS_READ_ONLY=1
            fi

            shift 2
            ;;

        --docker-arg)
            [[ $# -ge 2 ]] || {
                echo "Missing value for --docker-arg" >&2
                exit 1
            }

            DOCKER_ARGS+=("$2")
            shift 2
            ;;

        -h|--help)
            usage
            exit 0
            ;;

        --)
            shift
            COMMAND=("$@")
            break
            ;;

        *)
            COMMAND=("$@")
            break
            ;;
    esac
done

# -----------------------------------------------------------------------------
# Built-in commands
# -----------------------------------------------------------------------------

if [[ ${#COMMAND[@]} -gt 0 ]]; then
    case "${COMMAND[0]}" in
        build|exec|stop|delete|status|list|ls|init)
            if [[ "$CREDENTIALS_REQUESTED" == 1 ]]; then
                echo "Credential options cannot be used with 'agent ${COMMAND[0]}'." >&2
                echo "They only apply when creating a new container." >&2
                exit 1
            fi
            ;;
    esac

    case "${COMMAND[0]}" in
        init)
            SCRIPT_PATH="$(resolve_realpath "$0")"
            BIN_DIR="$AGENT_HOME/bin"
            ZSHRC="${ZDOTDIR:-$HOME}/.zshrc"
            PATH_EXPORT="export PATH=\"${BIN_DIR}:\$PATH\""

            mkdir -p "$BIN_DIR"

            ln -sf "$SCRIPT_PATH" "$BIN_DIR/agent"
            ln -sf "$SCRIPT_PATH" "$BIN_DIR/agent-container"

            if [[ -f "$ZSHRC" ]] && grep -Fq "$PATH_EXPORT" "$ZSHRC"; then
                echo "PATH entry already present in $ZSHRC."
            else
                printf '\n# agent-container launcher\n%s\n' "$PATH_EXPORT" >> "$ZSHRC"
                echo "Added PATH entry to $ZSHRC."
            fi

            echo
            echo "Installed shortcuts:"
            echo "  $BIN_DIR/agent"
            echo "  $BIN_DIR/agent-container"
            echo
            echo "Restart your shell or run: source $ZSHRC"
            echo "Then use 'agent' from anywhere."
            exit 0
            ;;

        build)
            build_image "${COMMAND[@]:1}"
            exit $?
            ;;

        codex-ssh)
            CODEX_SSH_PORT=""

            while read -r container; do
                [[ -n "$container" ]] || continue

                CODEX_SSH_PORT="$(run_docker inspect \
                    --format '{{with index .NetworkSettings.Ports "22/tcp"}}{{(index . 0).HostPort}}{{end}}' \
                    "$container")"

                if [[ -n "$CODEX_SSH_PORT" ]]; then
                    break
                fi
            done < <(run_docker ps \
                --filter "label=agent-container=true" \
                --filter "publish=1455" \
                --format '{{.ID}}')

            if [[ -z "$CODEX_SSH_PORT" ]]; then
                echo "No running agent container publishes host port 1455." >&2
                exit 1
            fi

            if [[ -f "${HOME}/.ssh/known_hosts" ]] && grep -Fq "[localhost]:${CODEX_SSH_PORT}" "${HOME}/.ssh/known_hosts"; then
                ssh-keygen -R "[localhost]:${CODEX_SSH_PORT}"
            fi

            exec ssh -p "$CODEX_SSH_PORT" -L 1455:localhost:1455 root@localhost
            ;;

        exec)
            container="$(require_running_container)"

            if [[ ${#COMMAND[@]} -eq 1 ]]; then
                if interactive_tty; then
                    run_interactive run_docker exec \
                        "${IO_ARGS[@]}" \
                        --workdir /workspace \
                        "$container" \
                        bash
                fi

                exec_docker exec \
                    "${IO_ARGS[@]}" \
                    --workdir /workspace \
                    "$container" \
                    bash
            fi

            exec_docker exec \
                "${IO_ARGS[@]}" \
                --workdir /workspace \
                "$container" \
                "${COMMAND[@]:1}"
            ;;

        stop)
            container="$(find_running_container)"

            if [[ -z "$container" ]]; then
                echo "No running agent container for:"
                echo "  $WORKSPACE"
                exit 0
            fi

            echo "Stopping agent container $container"
            run_docker stop "$container"
            exit 0
            ;;

        delete)
            container="$(find_existing_container)"

            if [[ -z "$container" ]]; then
                echo "No agent container to delete for:"
                echo "  $WORKSPACE"
                exit 0
            fi

            echo "Deleting agent container $container"
            run_docker rm -f "$container" >/dev/null
            exit 0
            ;;

        status)
            container="$(find_running_container)"

            if [[ -z "$container" ]]; then
                echo "No agent container is running for:"
                echo "  $WORKSPACE"
                exit 1
            fi

            echo "Agent container is running:"
            run_docker ps \
                --filter "id=$container" \
                --format '  ID:       {{.ID}}
  Name:     {{.Names}}
  Image:    {{.Image}}
  Status:   {{.Status}}
  Ports:    {{.Ports}}'

            exit 0
            ;;

        list|ls)
            run_docker ps \
                --filter "label=agent-container=true" \
                --format 'ID: {{.ID}}	Name: {{.Names}}	Image: {{.Image}}	Status: {{.Status}}	Ports: {{.Ports}}	PWD: {{.Label "agent-workspace-path"}}'
            exit 0
            ;;
    esac
fi

# -----------------------------------------------------------------------------
# Attach to an existing workspace container
# -----------------------------------------------------------------------------

if [[ ${#COMMAND[@]} -eq 0 ]]; then
    RUNNING_CONTAINER="$(find_running_container)"

    if [[ -n "$RUNNING_CONTAINER" ]]; then
        if [[ "$CREDENTIALS_REQUESTED" == 1 ]]; then
            credentials_require_new_container
        fi

        if [[ ${#EXTRA_PORTS[@]} -gt 0 ]]; then
            ports_require_new_container
        fi

        echo "Attaching to agent container $RUNNING_CONTAINER"

        if interactive_tty; then
            run_interactive run_docker exec \
                "${IO_ARGS[@]}" \
                --workdir /workspace \
                "$RUNNING_CONTAINER" \
                bash
        fi

        exec_docker exec \
            "${IO_ARGS[@]}" \
            --workdir /workspace \
            "$RUNNING_CONTAINER" \
            bash
    fi
fi

# -----------------------------------------------------------------------------
# Prevent duplicate workspace containers
# -----------------------------------------------------------------------------

RUNNING_CONTAINER="$(find_running_container)"

if [[ -n "$RUNNING_CONTAINER" ]]; then
    if [[ "$CREDENTIALS_REQUESTED" == 1 ]]; then
        credentials_require_new_container
    fi

    echo "An agent container is already running for this workspace:"
    echo "  $WORKSPACE"
    echo
    echo "Container:"
    echo "  $RUNNING_CONTAINER"
    echo

    if [[ ${#EXTRA_PORTS[@]} -gt 0 ]]; then
        echo "It does not publish the requested ports:"
        requested_ports_summary
        echo
        echo "Docker fixes published ports when a container is created, so they"
        echo "require deleting this container and starting a new one."
        echo
    fi

    echo "Use one of:"
    echo "  agent"
    echo "  agent exec <command>"
    echo "  agent stop"
    echo "  agent delete"
    exit 1
fi

ensure_image_exists

# -----------------------------------------------------------------------------
# Optional credential profile
# -----------------------------------------------------------------------------

if [[ "$CREDENTIALS_REQUESTED" == 1 ]]; then
    if [[ ! -d "$CREDENTIALS_DIR" ]]; then
        echo "Credential profile is not a directory:" >&2
        echo "  $CREDENTIALS_DIR" >&2
        exit 1
    fi

    CREDENTIALS_DIR="$(cd "$CREDENTIALS_DIR" && pwd -P)"
    SSH_CREDENTIALS_DIR="$CREDENTIALS_DIR/.ssh"
    GITHUB_CREDENTIALS_DIR="$CREDENTIALS_DIR/.config/gh"

    if [[ ( -e "$SSH_CREDENTIALS_DIR" || -L "$SSH_CREDENTIALS_DIR" ) && ! -d "$SSH_CREDENTIALS_DIR" ]]; then
        echo "SSH credential path is not a directory:" >&2
        echo "  $SSH_CREDENTIALS_DIR" >&2
        exit 1
    fi

    if [[ ( -e "$GITHUB_CREDENTIALS_DIR" || -L "$GITHUB_CREDENTIALS_DIR" ) && ! -d "$GITHUB_CREDENTIALS_DIR" ]]; then
        echo "GitHub credential path is not a directory:" >&2
        echo "  $GITHUB_CREDENTIALS_DIR" >&2
        exit 1
    fi

    CREDENTIAL_VOLUME_SUFFIX=""

    if [[ "$CREDENTIALS_READ_ONLY" == 1 ]]; then
        CREDENTIAL_VOLUME_SUFFIX=":ro"
    fi

    if [[ -d "$SSH_CREDENTIALS_DIR" ]]; then
        CREDENTIAL_MOUNT_ARGS+=(
            --volume "$SSH_CREDENTIALS_DIR:/home/agent/.ssh${CREDENTIAL_VOLUME_SUFFIX}"
        )
    fi

    if [[ -d "$GITHUB_CREDENTIALS_DIR" ]]; then
        CREDENTIAL_MOUNT_ARGS+=(
            --volume "$GITHUB_CREDENTIALS_DIR:/home/agent/.config/gh${CREDENTIAL_VOLUME_SUFFIX}"
        )
    fi

    if [[ ${#CREDENTIAL_MOUNT_ARGS[@]} -eq 0 ]]; then
        echo "Credential profile contains no supported credential directories:" >&2
        echo "  $CREDENTIALS_DIR" >&2
        echo "Expected .ssh and/or .config/gh." >&2
        exit 1
    fi
fi

EXISTING_CONTAINER="$(find_existing_container)"

if [[ -n "$EXISTING_CONTAINER" ]]; then
    if [[ ! -t 0 ]]; then
        echo "An existing agent container was found for this workspace:" >&2
        echo "  $WORKSPACE" >&2
        echo "  $EXISTING_CONTAINER" >&2
        echo >&2
        echo "Run interactively to choose whether to reuse or delete it," >&2
        echo "or run 'agent delete' first." >&2
        exit 1
    fi

    echo "An existing agent container was found for this workspace:"
    echo "  $WORKSPACE"
    echo
    echo "Container:"
    echo "  $EXISTING_CONTAINER"
    echo

    if [[ ${#EXTRA_PORTS[@]} -gt 0 ]]; then
        echo "Reusing it cannot publish the requested ports:"
        requested_ports_summary
        echo
        echo "Docker fixes published ports when a container is created."
        echo "Delete it to create a container that publishes them."
        echo
    fi

    if ! read -r -p "Use existing container, delete it, or cancel? [u/d/C] " response; then
        echo >&2
        exit 1
    fi

    case "$response" in
        d|D)
            echo "Deleting existing container..."
            run_docker rm -f "$EXISTING_CONTAINER" >/dev/null
            ;;
        u|U)
            if [[ ${#EXTRA_PORTS[@]} -gt 0 ]]; then
                echo "Reusing the existing container; requested ports are not published."
            fi

            echo "Starting existing container..."
            run_docker start "$EXISTING_CONTAINER" >/dev/null
            echo "Attaching to existing container..."
            if interactive_tty; then
                run_interactive run_docker exec \
                    "${IO_ARGS[@]}" \
                    --workdir /workspace \
                    "$EXISTING_CONTAINER" \
                    bash
            fi
            exec_docker exec \
                "${IO_ARGS[@]}" \
                --workdir /workspace \
                "$EXISTING_CONTAINER" \
                bash
            ;;
        *)
            echo "Cancelled."
            exit 1
            ;;
    esac
fi

# -----------------------------------------------------------------------------
# Codex-specific defaults
# -----------------------------------------------------------------------------

if [[ ${#COMMAND[@]} -gt 0 && "${COMMAND[0]}" == "codex" ]]; then
    if [[ -f "$AGENT_HOME/.codex/auth.json" ]]; then
        CODEX_AUTH_ENABLED=0
    fi

    CODEX_SANDBOX_CONFIGURED=0

    for arg in "${COMMAND[@]:1}"; do
        case "$arg" in
            --sandbox|--sandbox=*|-s|-s?*|--dangerously-bypass-approvals-and-sandbox|--yolo)
                CODEX_SANDBOX_CONFIGURED=1
                break
                ;;
        esac
    done

    if [[ "$CODEX_SANDBOX_CONFIGURED" == 0 ]]; then
        COMMAND=(
            codex
            --sandbox danger-full-access
            "${COMMAND[@]:1}"
        )
    fi

    if [[ "$CODEX_AUTH_ENABLED" == 1 ]]; then
        PUBLISH_SSH=1
        PUBLISH_CODEX=1
    fi
else
    PUBLISH_SSH=0
    PUBLISH_CODEX=0
fi

# -----------------------------------------------------------------------------
# Claude Code-specific defaults
# -----------------------------------------------------------------------------

if [[ ${#COMMAND[@]} -gt 0 && "${COMMAND[0]}" == "claude" ]]; then
    CLAUDE_PERMISSIONS_CONFIGURED=0

    for arg in "${COMMAND[@]:1}"; do
        case "$arg" in
            --permission-mode|--permission-mode=*|--dangerously-skip-permissions|--allow-dangerously-skip-permissions)
                CLAUDE_PERMISSIONS_CONFIGURED=1
                break
                ;;
        esac
    done

    if [[ "$CLAUDE_PERMISSIONS_CONFIGURED" == 0 ]]; then
        COMMAND=(
            claude
            --dangerously-skip-permissions
            "${COMMAND[@]:1}"
        )
    fi
fi

# -----------------------------------------------------------------------------
# OpenCode-specific defaults
# -----------------------------------------------------------------------------

if [[ ${#COMMAND[@]} -gt 0 && "${COMMAND[0]}" == "opencode" ]]; then
    OPENCODE_PERMISSIONS_CONFIGURED=0

    for arg in "${COMMAND[@]:1}"; do
        case "$arg" in
            --auto|--yolo|--dangerously-skip-permissions)
                OPENCODE_PERMISSIONS_CONFIGURED=1
                break
                ;;
        esac
    done

    if [[ "$OPENCODE_PERMISSIONS_CONFIGURED" == 0 ]]; then
        COMMAND=(
            opencode
            --dangerously-skip-permissions
            "${COMMAND[@]:1}"
        )
    fi
fi

# -----------------------------------------------------------------------------
# Persistent state
# -----------------------------------------------------------------------------

mkdir -p \
    "$AGENT_HOME/.codex" \
    "$AGENT_HOME/.claude" \
    "$AGENT_HOME/.config/opencode" \
    "$AGENT_HOME/.local/share/opencode"

# -----------------------------------------------------------------------------
# docker run arguments
# -----------------------------------------------------------------------------

RUN_ARGS=(
    "${IO_ARGS[@]}"
    --init

    --name "$CONTAINER_NAME"

    --label "agent-container=true"
    --label "agent-workspace=${WORKSPACE_ID}"
    --label "agent-workspace-path=${WORKSPACE}"

    --add-host "host.docker.internal:host-gateway"
    --workdir /workspace

    # Claude Code refuses --dangerously-skip-permissions as root unless it is
    # told the surrounding environment is already a sandbox.
    --env IS_SANDBOX=1

    --volume "$WORKSPACE:/workspace"

    --volume "$AGENT_HOME/.codex:/home/agent/.codex"
    --volume "$AGENT_HOME/.claude:/home/agent/.claude"
    --volume "$AGENT_HOME/.config/opencode:/home/agent/.config/opencode"
    --volume "$AGENT_HOME/.local/share/opencode:/home/agent/.local/share/opencode"
)

RUN_ARGS+=("${CREDENTIAL_MOUNT_ARGS[@]}")

if [[ "$CODEX_AUTH_ENABLED" == 0 ]]; then
    RUN_ARGS+=(--env CODEX_AUTH_ENABLED=0)
fi

# -----------------------------------------------------------------------------
# Ports
# -----------------------------------------------------------------------------

log_verbose "workspace:      $WORKSPACE"
log_verbose "workspace id:   $WORKSPACE_ID"
log_verbose "container name: $CONTAINER_NAME"
log_verbose "image:          $IMAGE"
log_verbose "requested ports: ${EXTRA_PORTS[*]:-none}"

PORT_ARGS=()

if [[ "$PUBLISH_SSH" == 1 ]]; then
    RESOLVED_SSH_HOST_PORT="$(find_available_ssh_port)"

    PORT_ARGS+=(
        --publish "127.0.0.1:${RESOLVED_SSH_HOST_PORT}:22"
    )

    echo "SSH:   localhost:${RESOLVED_SSH_HOST_PORT} -> container:22"
fi

if [[ "$PUBLISH_CODEX" == 1 ]]; then
    PORT_ARGS+=(
        --publish "127.0.0.1:${CODEX_HOST_PORT}:1455"
    )

    echo "Codex: localhost:${CODEX_HOST_PORT} -> container:1455"
fi

for port in "${EXTRA_PORTS[@]}"; do
    if [[ "$port" != *:* ]]; then
        port="${port}:${port}"
    fi

    PORT_ARGS+=(
        --publish "$port"
    )

    echo "Port:  ${port%:*} -> container:${port##*:}"
done

# -----------------------------------------------------------------------------
# Launch
# -----------------------------------------------------------------------------

if (( ${#COMMAND[@]} > 0 )); then
    run_interactive run_docker run \
        "${RUN_ARGS[@]}" \
        "${PORT_ARGS[@]}" \
        "${DOCKER_ARGS[@]}" \
        "$IMAGE" \
        "${COMMAND[@]}"
else
    run_interactive run_docker run \
        "${RUN_ARGS[@]}" \
        "${PORT_ARGS[@]}" \
        "${DOCKER_ARGS[@]}" \
        "$IMAGE"
fi
