#!/usr/bin/env bash
set -euo pipefail

AGENT_USER=agent

if ! AGENT_USER="$AGENT_USER" /usr/local/bin/agent-config-audit; then
  echo "Warning: unable to audit external configuration paths." >&2
fi

if [[ $# -eq 0 ]]; then
  exec gosu "$AGENT_USER" bash
fi

if [[ "$1" == "codex" && "${CODEX_AUTH_ENABLED:-1}" == 1 ]]; then
  if [[ -n "${AGENT_SSH_PASSWORD:-}" ]]; then
    SSH_PASSWORD="$AGENT_SSH_PASSWORD"
    PASSWORD_SOURCE="provided by AGENT_SSH_PASSWORD"
  elif [[ -n "${ROOT_PASSWORD:-}" ]]; then
    # Preserve the old, undocumented override name without enabling root login.
    SSH_PASSWORD="$ROOT_PASSWORD"
    PASSWORD_SOURCE="provided by ROOT_PASSWORD"
  else
    SSH_PASSWORD="$(
      head -c 32 /dev/urandom \
        | base64 \
        | tr -d '\n=+/'
    )"

    PASSWORD_SOURCE="randomly generated"
  fi

  echo "${AGENT_USER}:${SSH_PASSWORD}" | /usr/sbin/chpasswd

  echo
  echo "============================================================"
  echo " SSH credentials (${PASSWORD_SOURCE})"
  echo "------------------------------------------------------------"
  echo " User:     ${AGENT_USER}"
  echo " Password: ${SSH_PASSWORD}"
  echo " Port:     22"
  echo "============================================================"
  echo

  mkdir -p /run/sshd
  /usr/sbin/sshd
  unset SSH_PASSWORD AGENT_SSH_PASSWORD ROOT_PASSWORD
fi

case "$1" in
  codex|claude|opencode)
    if [[ -t 0 && -t 1 ]]; then
      trap 'interrupted=1' INT

      interrupted=0
      exit_status=0
      gosu "$AGENT_USER" "$@" || exit_status=$?

      echo
      if [[ "$interrupted" -eq 1 ]]; then
        echo "Command interrupted."
      else
        echo "Command exited (status ${exit_status})."
      fi
      echo "Dropping to an interactive shell. Press Ctrl-D or type 'exit' to stop the container."
      echo
      printf '%s\n' "$*" >> "/home/${AGENT_USER}/.bash_history"
      exec gosu "$AGENT_USER" bash
    fi
    ;;
esac

exec gosu "$AGENT_USER" "$@"
