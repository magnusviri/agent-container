# Uncomment any setting below to override its Dockerfile default. Tool settings
# accept an exact version, "latest", or an empty value to omit that tool. All
# tools default to "latest", except Go, Swift, and Terraform, which default to
# being omitted.
# When using "latest", disable the Docker build cache to ensure that the newest
# version is installed:
#
#   agent build --no-cache

# Debian image tag (for example, "bookworm-slim" or "latest"):

# DEBIAN_VERSION=latest

# Language version (for example, "3.14.6" or "latest"). Set blank to skip it:

# PYTHON_VERSION=latest
# RUBY_VERSION=latest
# NODE_VERSION=latest

# Go version (for example, "1.26.0" or "latest"). Set blank to skip it.
# Go is not installed unless you set this value:

# GO_VERSION=

# Swift version (for example, "6.1.3" or "latest"). Set blank to skip it.
# Swift is not installed unless you set this value:

# SWIFT_VERSION=

# Terraform version (for example, "1.12.2" or "latest"). Set blank to skip it.
# Terraform is not installed unless you set this value:

# TERRAFORM_VERSION=

# Bundler version (for example, "4.0.17" or "latest"). Set blank to skip it.

# BUNDLER_VERSION=4.0.17

# Agent version (for example, "0.147.0" or "latest"). Set blank to skip it:

# CLAUDE_CODE_VERSION=latest
# CODEX_VERSION=latest
# OPENCODE_VERSION=latest
