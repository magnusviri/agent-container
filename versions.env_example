# Uncomment any setting below to override its Dockerfile default. Tool settings
# accept an exact version, "latest", or an empty value to omit that tool. All
# tools default to "latest". When using "latest", disable the Docker build
# cache to ensure that the newest version is installed:
#
#   agent build --no-cache

# Debian image tag (for example, "bookworm-slim" or "latest"):

# DEBIAN_VERSION=latest

# Language version (for example, "3.14.6" or "latest"). Set blank to skip it:

# PYTHON_VERSION=latest
# RUBY_VERSION=latest
# NODE_VERSION=latest

# Bundler version (for example, "4.0.17" or "latest"). Set blank to skip it.

# BUNDLER_VERSION=4.0.17

# Agent version (for example, "0.147.0" or "latest"). Set blank to skip it:

# CLAUDE_CODE_VERSION=latest
# CODEX_VERSION=latest
# OPENCODE_VERSION=latest
