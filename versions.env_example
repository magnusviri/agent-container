# Uncomment any setting below to override its Dockerfile default. Most settings
# accept either an exact version or "latest". When using "latest", disable the
# Docker build cache to ensure that the newest version is installed:
#
#   agent-build --no-cache

# Debian image tag (for example, "bookworm-slim" or "latest"):

# DEBIAN_VERSION=latest

# Language version (for example, "3.14.6" or "latest"):

# PYTHON_VERSION=latest
# RUBY_VERSION=latest
# NODE_VERSION=latest

# Bundler requires a RubyGems version or version constraint; "latest" is not valid.

# BUNDLER_VERSION=4.0.17

# Agent version (for example, "0.147.0" or "latest"):

# CLAUDE_CODE_VERSION=latest
# CODEX_VERSION=latest
# OPENCODE_VERSION=latest
